# 🚀 VERCEL PRODUCTION - MINIMAL ESSENTIAL VARIABLES
# ===========================================
# COPY VARIABLES INI KE VERCEL DASHBOARD
# Settings > Environment Variables
# ===========================================

# ESSENTIAL - APPLICATION CORE (2 variables)
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://orders.id

# ESSENTIAL - FEATURE FLAGS (4 variables)
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_PORTFOLIO=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_NEWSLETTER=true